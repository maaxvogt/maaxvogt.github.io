---
import '../styles/global.css';

const { title = 'Max Vogt — AI Developer' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfolio of Max Vogt, AI developer." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Roboto:wght@400;500&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div data-view-content="human"><slot /></div>
    <pre data-view-content="machine" class="machine-view"><slot name="machine" /></pre>

    <div class="view-toggle" data-view-toggle-group>
      <button type="button" data-view-set="human" class="view-toggle-btn" aria-pressed="true">Human</button>
      <button type="button" data-view-set="machine" class="view-toggle-btn" aria-pressed="false">Machine</button>
    </div>

    <script>
      const root = document.documentElement;
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme) root.dataset.theme = storedTheme;

      const syncToggles = () => {
        const isDark = root.dataset.theme === 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
          toggle.checked = isDark;
        });
      };

      const applyTheme = (isDark) => {
        root.dataset.theme = isDark ? 'dark' : 'light';
        localStorage.setItem('theme', root.dataset.theme);
        syncToggles();
      };

      syncToggles();

      document.addEventListener('change', (event) => {
        if (event.target && event.target.matches('[data-theme-toggle]')) {
          applyTheme(event.target.checked);
        }
      });

      const storedView = localStorage.getItem('view');
      root.dataset.view = storedView === 'machine' ? 'machine' : 'human';

      const syncViewButtons = () => {
        document.querySelectorAll('[data-view-set]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.dataset.viewSet === root.dataset.view));
        });
      };

      const applyView = (view) => {
        root.dataset.view = view;
        localStorage.setItem('view', view);
        syncViewButtons();
      };

      syncViewButtons();

      document.addEventListener('click', (event) => {
        const btn = event.target.closest('[data-view-set]');
        if (btn) applyView(btn.dataset.viewSet);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            } else {
              entry.target.classList.remove('is-visible');
            }
          });
        },
        { threshold: 0.15 }
      );

      window.addEventListener('load', () => {
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
